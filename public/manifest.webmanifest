      "icons": [{ "src": "/images/inventory-mobile-icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Revisar una sala",
      "short_name": "Revisar sala",
      "url": "/mobile/rooms",
      "icons": [{ "src": "/images/inventory-mobile-icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
